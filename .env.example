# ---- Required ----
# The engine resolves credentials the way the Anthropic SDK does:
# ANTHROPIC_API_KEY, then ANTHROPIC_AUTH_TOKEN, then an `ant auth login` profile.
ANTHROPIC_API_KEY=sk-ant-...

# ---- Core ----
PORT=8787
DATABASE_PATH=./data/autopilot.db
# Guards the dashboard and API. Generate one: openssl rand -hex 32
ADMIN_TOKEN=

# Model used for brand analysis and campaign planning.
# Lower cost lever: set to claude-sonnet-5-5 (5x cheaper in, 2x cheaper out).
# See README "What it costs to run" before changing this.
MODEL=claude-opus-5-5
PLANNER_EFFORT=high

# Public origin this server is reachable at, e.g. https://marketing.example.com
# The tracking snippet embeds this, so it must be resolvable by visitors.
PUBLIC_URL=http://localhost:8787

# ---- Scheduler ----
# Minutes between publish sweeps.
PUBLISH_INTERVAL_MINUTES=5
# Minutes between metric collection sweeps.
METRICS_INTERVAL_MINUTES=60
# Hours between campaign planning runs per business.
PLAN_INTERVAL_HOURS=168
# Minutes between website health checks.
MONITOR_INTERVAL_MINUTES=5
# Hours between site content crawls.
CRAWL_INTERVAL_HOURS=168
# Master kill switch. Set to false to stop ALL outbound publishing instantly.
PUBLISHING_ENABLED=true

# ---- Channels ----
# Each channel stays in simulation mode until its credentials are present.
# Simulated sends are recorded and clearly labelled; they never leave the server.

# Email - https://resend.com (no approval needed)
RESEND_API_KEY=
EMAIL_FROM="Your Brand <hello@yourdomain.com>"

# X / Twitter - requires a paid API tier
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# LinkedIn - requires Community Management API partner approval
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_URN=urn:li:organization:000000

# Meta (Facebook Page + Instagram Business) - requires App Review
META_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
